# Build artefacts produced by debhelper / dpkg-buildpackage.
# Source-of-truth for these is the build process, not git.

# Generated by pandoc from debian/duckdb.1.md in debian/rules.
/duckdb.1

# Per-build state directory managed by debhelper.
/.debhelper/

# Per-package staging trees (filled by dh_install before dh_builddeb).
/duckdb/
/libduckdb-dev/
/libduckdb1/
/tmp/

# Build stamps and substitution files.
/debhelper-build-stamp
/files
*.debhelper.log
*.substvars

# Test infrastructure scratch.
/autopkgtest-out/

# mk-build-deps drops a control file here while resolving deps.
/duckdb-build-deps_*.deb
/duckdb-build-deps_*.buildinfo
/duckdb-build-deps_*.changes
