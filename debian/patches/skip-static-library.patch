Description: Make the libduckdb_static.a target optional, default off for packaging
 The Debian packaging does not ship libduckdb_static.a (it is deleted
 in debian/rules' override_dh_auto_install -- users link the shared
 library).  Upstream CMake nevertheless builds the static archive
 unconditionally.  For a Release build with debug info that archive
 is ~2 GB, which on a disk-constrained CI runner (GitHub-hosted
 runners have ~14 GB free) tips the build over into
 "No space left on device" when ar(1) assembles it.
 .
 This patch introduces a BUILD_STATIC_LIBRARY option (default ON, so
 upstream and other consumers see no behaviour change) and gates both
 the add_library() and the install(TARGETS ...) on it.  The Debian
 build passes -DBUILD_STATIC_LIBRARY=OFF via debian/rules, so the
 archive is never created and the disk pressure disappears.
 .
 The shared library, the CLI, and all extensions are unaffected --
 they are built from the same ${ALL_OBJECT_FILES} object set, which
 is still produced.  Only the final .a archiving step is skipped.
Author: Michal J. Gajda <mjgajda@gmail.com>
Forwarded: not-yet
Last-Update: 2026-05-19
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 5961bbacf4..59f9e88abe 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -87,9 +87,17 @@ foreach(LINK_LIB ${DUCKDB_LINK_LIBS})
   list(APPEND LINK_OBJECTS $<TARGET_OBJECTS:${LINK_LIB}>)
 endforeach(LINK_LIB)
 
-add_library(duckdb_static STATIC ${ALL_OBJECT_FILES} ${LINK_OBJECTS})
-target_link_libraries(duckdb_static PUBLIC ${DUCKDB_SYSTEM_LIBS})
-link_threads(duckdb_static PUBLIC)
+# BUILD_STATIC_LIBRARY (default ON): when OFF, libduckdb_static.a is
+# neither built nor installed.  Debian packaging passes OFF because
+# it does not ship the static archive and building it costs ~2 GB
+# of disk for a Release-with-debug-info build.
+option(BUILD_STATIC_LIBRARY "Build and install libduckdb_static.a" ON)
+
+if(BUILD_STATIC_LIBRARY)
+  add_library(duckdb_static STATIC ${ALL_OBJECT_FILES} ${LINK_OBJECTS})
+  target_link_libraries(duckdb_static PUBLIC ${DUCKDB_SYSTEM_LIBS})
+  link_threads(duckdb_static PUBLIC)
+endif()
 
 #
 # FIXME file(COPY ${CMAKE_SOURCE_DIR}/libduckdb_static.a  DESTINATION
@@ -141,9 +149,17 @@ install(FILES "${PROJECT_SOURCE_DIR}/src/include/duckdb.hpp"
               "${PROJECT_SOURCE_DIR}/src/include/duckdb.h"
         DESTINATION "${INSTALL_INCLUDE_DIR}")
 
-install(
-  TARGETS duckdb duckdb_static
-  EXPORT "${DUCKDB_EXPORT_SET}"
-  LIBRARY DESTINATION "${INSTALL_LIB_DIR}"
-  ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
-  RUNTIME DESTINATION "${INSTALL_BIN_DIR}")
+if(BUILD_STATIC_LIBRARY)
+  install(
+    TARGETS duckdb duckdb_static
+    EXPORT "${DUCKDB_EXPORT_SET}"
+    LIBRARY DESTINATION "${INSTALL_LIB_DIR}"
+    ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
+    RUNTIME DESTINATION "${INSTALL_BIN_DIR}")
+else()
+  install(
+    TARGETS duckdb
+    EXPORT "${DUCKDB_EXPORT_SET}"
+    LIBRARY DESTINATION "${INSTALL_LIB_DIR}"
+    RUNTIME DESTINATION "${INSTALL_BIN_DIR}")
+endif()
